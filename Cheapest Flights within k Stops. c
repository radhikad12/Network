#include <stdlib.h>
#include <string.h>
#include <limits.h>

int findCheapestPrice(int n, int** flights, int flightsSize, int* flightsColSize, int src, int dst, int k) {
    int* dist = (int*)malloc(n * sizeof(int));
    int* tempDist = (int*)malloc(n * sizeof(int));
    
    for (int i = 0; i < n; i++) {
        dist[i] = INT_MAX;
    }
    dist[src] = 0;
    
    for (int i = 0; i <= k; i++) {
        memcpy(tempDist, dist, n * sizeof(int));
        
        for (int j = 0; j < flightsSize; j++) {
            int u = flights[j][0];
            int v = flights[j][1];
            int w = flights[j][2];
            
            if (dist[u] != INT_MAX) {
                if (dist[u] + w < tempDist[v]) {
                    tempDist[v] = dist[u] + w;
                }
            }
        }
        memcpy(dist, tempDist, n * sizeof(int));
    }
    
    int result = dist[dst] == INT_MAX ? -1 : dist[dst];
    
    free(dist);
    free(tempDist);
    
    return result;
}
